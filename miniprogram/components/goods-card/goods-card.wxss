.card-hover { opacity: 0.86; }

/* ---------- 瀑布流卡片 ---------- */
.pcard {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(23, 43, 29, 0.06);
}
.pcard-media {
  position: relative;
  width: 100%;
  background: #E4EAF1;
  overflow: hidden;
}
.pcard-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ph-tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  line-height: 1.4;
  color: #fff;
  background: rgba(21, 40, 28, 0.55);
}
.seal {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #EAF7DA, #B9DE8C 70%);
  border: 4rpx dashed rgba(43, 122, 75, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}
.seal-ic { width: 32rpx; height: 32rpx; }

.pcard-body { padding: 16rpx 18rpx 20rpx; }
.pcard-title {
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.36;
  color: #1B1E22;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.pcard-em {
  color: #3FA362;
  font-weight: 800;
  margin-right: 6rpx;
}
.pcard-sub {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #8C929B;
}
.pcard-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pcard-link {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #3FA362;
}
.pcard-link-ic { width: 22rpx; height: 22rpx; margin-left: 2rpx; }

.mini-btn {
  padding: 8rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #DCF1B8, #C3E4A0);
  color: #2B7A4B;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
}

/* ---------- 列表大卡 ---------- */
.lcard {
  display: flex;
  padding: 20rpx;
  margin: 0 28rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 43, 29, 0.06);
}
.lcard-media {
  position: relative;
  width: 216rpx;
  height: 192rpx;
  flex: 0 0 auto;
  border-radius: 20rpx;
  overflow: hidden;
  background: #E4EAF1;
}
.lcard-img { width: 100%; height: 100%; display: block; }
.lcard-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}
.lcard-title {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.36;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.lcard-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8C929B;
}
.lcard-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
.lcard-tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  color: #2B7A4B;
  background: #EFF7DC;
  margin-right: 10rpx;
  margin-bottom: 8rpx;
}
.lcard-foot {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.lcard-price { display: flex; align-items: baseline; }
.price-num { font-size: 32rpx; font-weight: 800; color: #F2555A; }
.price-unit { font-size: 20rpx; font-weight: 600; color: #9AA0A8; margin-left: 4rpx; }
