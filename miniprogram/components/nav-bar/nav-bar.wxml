<view class="nav" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-inner" style="height: {{navBarHeight}}px;">
    <view class="nav-back" wx:if="{{back}}" bindtap="onBack" hover-class="nav-back-hover">
      <image class="nav-back-ic" src="/assets/icons/back-{{theme === 'light' ? 'white' : 'dark'}}.png" mode="aspectFit" />
    </view>
    <view class="nav-title nav-title-{{theme}}">{{title}}</view>
  </view>
</view>
