<view class="tabbar">
  <!-- 前两个 tab -->
  <block wx:for="{{list}}" wx:key="text">
    <view
      class="tab"
      wx:if="{{index < 2}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <image class="tab-ic" src="/assets/icons/{{item.icon}}-{{selected === index ? 'green' : 'gray'}}.png" mode="aspectFit" />
      <text class="tab-txt {{selected === index ? 'on' : ''}}">{{item.text}}</text>
    </view>
  </block>

  <!-- 中间凸起发布按钮 -->
  <view class="tab-center" bindtap="onPublish" hover-class="bubble-hover">
    <view class="bubble">
      <text class="bubble-zhuan">转</text>
      <text class="bubble-equip">设备</text>
    </view>
  </view>

  <!-- 后两个 tab -->
  <block wx:for="{{list}}" wx:key="text">
    <view
      class="tab"
      wx:if="{{index >= 2}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <image class="tab-ic" src="/assets/icons/{{item.icon}}-{{selected === index ? 'green' : 'gray'}}.png" mode="aspectFit" />
      <text class="tab-txt {{selected === index ? 'on' : ''}}">{{item.text}}</text>
    </view>
  </block>
</view>
