.page-detail {
  min-height: 100vh;
  padding-bottom: calc(148rpx + env(safe-area-inset-bottom));
}

/* 主图 */
.d-media {
  position: relative;
  width: 100%;
  height: 536rpx;
  background: #E4EAF1;
}
.d-swiper { width: 100%; height: 100%; }
.d-img { width: 100%; height: 100%; display: block; }
.d-nav {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  z-index: 10;
}
.d-count {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(15, 20, 18, 0.45);
  color: #fff;
  font-size: 22rpx;
}

/* 价格标题 */
.d-head { padding: 28rpx 28rpx 0; }
.d-price { display: flex; align-items: baseline; }
.d-price-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #F2555A;
  letter-spacing: -1rpx;
}
.d-price-unit { font-size: 26rpx; font-weight: 700; color: #F2555A; margin-left: 2rpx; }
.d-negotiable {
  margin-left: 16rpx;
  font-size: 21rpx;
  color: #2B7A4B;
  background: #EFF7DC;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
}
.d-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #15171A;
}
.d-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}
.d-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  color: #5A6069;
  background: #F3F5F7;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}
.d-tag.g { color: #2B7A4B; background: #EFF7DC; }

/* 保障条 */
.d-guarantee {
  margin: 24rpx 28rpx 0;
  padding: 20rpx 24rpx;
  display: flex;
  border-radius: 20rpx;
  background: linear-gradient(100deg, #F5FAE8, #EDF7E0);
}
.dg-item {
  flex: 1;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #4C7A56;
}
.dg-ic { width: 28rpx; height: 28rpx; margin-right: 8rpx; }

/* 卡片 */
.d-card {
  margin: 24rpx 28rpx 0;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 43, 29, 0.06);
}
.d-card-title {
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}
.d-card-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(#8FD08A, #4FB877);
  margin-right: 12rpx;
}

.spec { display: flex; flex-wrap: wrap; }
.spec-item {
  width: 50%;
  display: flex;
  align-items: baseline;
  padding: 12rpx 0;
  font-size: 25rpx;
}
.spec-k { color: #6C727B; width: 140rpx; flex: 0 0 auto; }
.spec-v { color: #1B1E22; font-weight: 600; flex: 1; }

/* 卖家 */
.seller { display: flex; align-items: center; }
.seller-logo {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(140deg, #EAF7DA, #9FD98A);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #1E3325;
}
.seller-main { flex: 1; margin-left: 20rpx; min-width: 0; }
.seller-name {
  font-size: 27rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}
.seller-badge {
  font-size: 19rpx;
  font-weight: 700;
  color: #2B7A4B;
  background: #EFF7DC;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-left: 10rpx;
}
.seller-sub { margin-top: 6rpx; font-size: 21rpx; color: #8C929B; }
.seller-btn {
  padding: 10rpx 22rpx;
  border-radius: 24rpx;
  border: 2rpx solid #C6E4A2;
  color: #2B7A4B;
  font-size: 23rpx;
  font-weight: 600;
}

/* 描述 */
.desc-p {
  display: block;
  font-size: 25rpx;
  line-height: 1.75;
  color: #6C727B;
  margin-bottom: 12rpx;
}
.desc-note {
  display: block;
  margin-top: 16rpx;
  font-size: 21rpx;
  color: #B7BCC4;
}

/* 相似 */
.rel { display: flex; padding: 0 28rpx; }
.rel-item { flex: 1; }
.rel-item + .rel-item { margin-left: 20rpx; }

.d-loading {
  padding: 200rpx 0;
  text-align: center;
  color: #B7BCC4;
  font-size: 26rpx;
}

/* 底部操作栏 */
.d-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: calc(132rpx + env(safe-area-inset-bottom));
  padding: 0 28rpx calc(env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 28rpx rgba(23, 43, 29, 0.09);
}
.d-op {
  width: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #5A6069;
}
.d-op.on { color: #2B7A4B; }
.d-op-ic { width: 42rpx; height: 42rpx; }
.d-op-tx { font-size: 19rpx; margin-top: 4rpx; }
.d-btn-ghost {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  border: 3rpx solid #9ED486;
  color: #2B7A4B;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}
.d-btn-solid {
  flex: 1.25;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(120deg, #A8DA8A, #4FB877);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(79, 184, 119, 0.32);
}
