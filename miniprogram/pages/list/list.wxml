<view class="page-normal">

  <view class="l-top">
    <nav-bar title="{{title}}" back="{{true}}" theme="dark" />
    <view class="sort-bar">
      <view
        class="sort-item {{sortKey === item.key || (item.key === 'priceAsc' && sortKey === 'priceAsc') ? 'on' : ''}}"
        wx:for="{{sorts}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onSortTap"
      >
        <text>{{item.name}}</text>
        <text class="sort-arrow" wx:if="{{item.key === 'priceAsc'}}">{{priceDesc ? '↓' : '↑'}}</text>
      </view>
      <view class="sort-filter" bindtap="goSearch">
        <image class="sort-filter-ic" src="/assets/icons/search-dark.png" mode="aspectFit" />
      </view>
    </view>
  </view>

  <scroll-view class="cat-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="cat-chips">
      <view
        class="chip chip-auto {{activeCat === item.id ? 'on' : ''}}"
        wx:for="{{cats}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onCatTap"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <view class="total-line">
    <text>共 <text class="total-num">{{total}}</text> 台设备在售</text>
    <text class="total-right">{{keyword ? '关键词：' + keyword : '按发布时间排序'}}</text>
  </view>

  <goods-card
    wx:for="{{list}}"
    wx:key="id"
    item="{{item}}"
    mode="row"
  />

  <view class="list-end" wx:if="{{loading}}">正在加载…</view>
  <view class="empty" wx:elif="{{!list.length}}">没有符合条件的设备</view>
  <view class="list-end" wx:elif="{{!hasMore}}">— 已经到底啦 —</view>
  <view class="list-end" wx:else>上拉加载更多</view>
</view>
