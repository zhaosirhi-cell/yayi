page { background: #FFFFFF; }

.pick-banner {
  position: relative;
  margin: 20rpx 28rpx 0;
  height: 232rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(120deg, #DDF1F6 0%, #EAF6E6 52%, #FBF6D5 100%);
  box-shadow: 0 4rpx 20rpx rgba(23, 43, 29, 0.06);
}
.pb-tag {
  position: absolute;
  left: 50%;
  top: 22rpx;
  transform: translateX(-50%);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  background: #16281C;
  color: #fff;
  font-size: 20rpx;
  white-space: nowrap;
}
.pb-title {
  position: absolute;
  left: 28rpx;
  top: 78rpx;
  font-size: 42rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #14251A;
}
.pb-en {
  position: absolute;
  left: 28rpx;
  top: 138rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
  color: #6E8A76;
}
.pb-sub {
  position: absolute;
  left: 28rpx;
  bottom: 26rpx;
  display: flex;
}
.pb-sub-item {
  font-size: 19rpx;
  color: #2B7A4B;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 18rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
}
.pb-phone {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  width: 164rpx;
  height: 208rpx;
  border-radius: 24rpx;
  background: linear-gradient(160deg, #1B2A20, #2E4234);
  padding: 12rpx;
  box-shadow: 0 16rpx 36rpx rgba(30, 60, 45, 0.22);
}
.pb-screen {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #F2FAD9, #CDE7A8);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #1E3325;
}

.chip-picker { flex: 1; }
.chip-picker .chip { width: 100%; }

.pick-note {
  display: flex;
  align-items: center;
  margin: 16rpx 28rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: #EFF7DC;
  font-size: 23rpx;
  color: #2B7A4B;
}
.pick-note-ic { width: 28rpx; height: 28rpx; margin-right: 12rpx; }

.waterfall {
  display: flex;
  padding: 24rpx 28rpx 0;
}
.wf-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.wf-col:first-child { margin-right: 20rpx; }
.wf-item { display: block; margin-bottom: 20rpx; }

.loading-tip {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #B7BCC4;
}

.consult {
  position: fixed;
  right: 16rpx;
  bottom: calc(200rpx + env(safe-area-inset-bottom));
  z-index: 90;
  width: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.consult-av {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 34% 28%, #F3FADC, #B7E08C 70%);
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(30, 80, 45, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
}
.consult-ic { width: 44rpx; height: 44rpx; }
.consult-tx {
  margin-top: -14rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #8FD08A, #4FB877);
  color: #fff;
  font-size: 19rpx;
  font-weight: 700;
  white-space: nowrap;
}
